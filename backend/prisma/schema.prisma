// Prisma Schema for Chit Fund Management System (PostgreSQL / Supabase compatible)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  stateRegistrationNo String?
  address             String?
  phone               String?
  email               String?
  receiptPrefix       String?  @default("REC")
  settings            String? // JSON formatted business settings
  status              String   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users          User[]
  subscribers    Subscriber[]
  chitGroups     ChitGroup[]
  transactions   PaymentTransaction[]
  auditLogs      AuditLog[]
  accounts       Account[]
  journalEntries JournalEntry[]
  refunds        Refund[]
  handovers      CashHandover[]
  expenses       Expense[]
  businesses     Business[]
  sequences      CompanySequence[]

  // P2 configuration system. engineEnabled is an inert flag until engine groups exist (P5).
  engineEnabled       Boolean                  @default(false)
  // P4: ledger posting starts at this business date (D-19); null = automatic posting off
  ledgerCutoverDate   String?
  // P7: members can sign in only when the super admin enables the portal for the company (D-02)
  memberPortalEnabled Boolean                  @default(false)
  accountMappings     AccountMapping[]
  financialEvents     FinancialEvent[]
  financialPeriods    FinancialPeriod[]
  policyVersions      FinancialPolicyVersion[]
  policyPointers      PolicyPointer[]
  configSnapshots     ConfigSnapshot[]
}

model User {
  id               String   @id @default(uuid())
  companyId        String?
  role             String // SUPER_ADMIN, MANAGER, COLLECTION_STAFF
  username         String   @unique
  fullName         String
  phone            String   @unique
  email            String?  @unique
  passwordHash     String
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  aadhaarNo        String?
  panNo            String?
  address          String?
  emergencyContact String?
  dateOfBirth      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  assignedSubscribers  Subscriber[]         @relation("AssignedStaff")
  assignedChitGroups   ChitGroup[]          @relation("ChitGroupStaff")
  chitGroupAssignments ChitGroupStaff[]
  recordedTransactions PaymentTransaction[] @relation("RecordedBy")
  approvedPayouts      Payout[]             @relation("ApprovedBy")
  submittedHandovers   CashHandover[]       @relation("StaffHandover")
  verifiedHandovers    CashHandover[]       @relation("ManagerVerification")
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  linkedSubscribers    Subscriber[]         @relation("UserSubscriber")

  managedBusinesses         Business[]         @relation("ManagerBusinesses")
  assignedBusinesses        BusinessStaff[]    @relation("StaffAssignedBusinesses")
  createdKhataCustomers     KhataCustomer[]    @relation("CustomerCreator")
  recordedKhataTransactions KhataTransaction[] @relation("KhataTxRecorder")

  createdSchedules      AuctionSchedule[]        @relation("ScheduleCreatedBy")
  submittedSettlements  AuctionSettlement[]      @relation("SettlementSubmittedBy")
  approvedSettlements   AuctionSettlement[]      @relation("SettlementApprovedBy")
  requestedAdjustments  FinancialAdjustment[]    @relation("AdjustmentRequestedBy")
  decidedAdjustments    FinancialAdjustment[]    @relation("AdjustmentDecidedBy")
  engineConversions     EngineConversion[]
  createdPolicyVersions FinancialPolicyVersion[] @relation("PolicyCreatedBy")
  decidedPolicyVersions FinancialPolicyVersion[] @relation("PolicyDecidedBy")
  lockedConfigSnapshots ConfigSnapshot[]         @relation("SnapshotLockedBy")

  @@index([companyId, role])
}

model Subscriber {
  id                  String    @id @default(uuid())
  companyId           String
  assignedStaffId     String?
  userId              String?
  subscriberCode      String
  fullName            String
  phone               String
  email               String?
  address             String?
  aadhaarNo           String?
  panNo               String?
  dateOfBirth         String?
  kycStatus           String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  kycNotes            String?
  kycVerifiedAt       DateTime?
  kycVerifiedByUserId String?
  idProofType         String? // AADHAAR, PAN, VOTER_ID, PASSPORT
  idProofNumber       String?
  nomineeName         String?
  nomineeRelation     String?
  nomineePhone        String?
  status              String    @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedStaff User?   @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  user          User?   @relation("UserSubscriber", fields: [userId], references: [id], onDelete: SetNull)

  memberships  ChitGroupMember[]
  transactions PaymentTransaction[]
  payouts      Payout[]
  auctionBids  AuctionBid[]
  auctionsWon  Auction[]            @relation("AuctionWinner")
  refunds      Refund[]

  @@unique([companyId, subscriberCode])
  @@unique([companyId, phone])
  @@index([companyId, status])
  @@index([assignedStaffId])
  @@index([userId])
}

model ChitGroup {
  id                   String   @id @default(uuid())
  companyId            String
  groupCode            String
  name                 String
  chitValue            Decimal  @db.Decimal(15, 2) // Total Pool Amount e.g. 500000.00
  maxMembers           Int // e.g. 20 members
  totalMonths          Int // e.g. 20 months
  monthlyInstallment   Decimal  @db.Decimal(15, 2) // Scheduled monthly installment e.g. 25000.00
  foremanCommissionPct Decimal  @default(5.0) @db.Decimal(5, 2) // 5%
  startDate            String // YYYY-MM-DD
  endDate              String? // YYYY-MM-DD
  auctionFrequency     String   @default("MONTHLY") // MONTHLY
  status               String   @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED, CLOSED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedStaffId String?
  assignedStaff   User?   @relation("ChitGroupStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  members          ChitGroupMember[]
  staffAssignments ChitGroupStaff[]
  schedules        InstallmentSchedule[]
  transactions     PaymentTransaction[]
  auctions         Auction[]
  refunds          Refund[]

  // P2: "LEGACY" groups keep the existing workflow; engine groups arrive with P5 (D-32).
  engineVersion  String                   @default("LEGACY")
  policyVersions FinancialPolicyVersion[]

  // P3: engine dues
  contributionPeriods ContributionPeriod[]
  memberDues          MemberDue[]
  engineConversion    EngineConversion?

  // P5: schedules and auction sessions
  auctionSchedules AuctionSchedule[]
  auctionSessions  AuctionSession[]

  @@unique([companyId, groupCode])
  @@index([companyId, status])
  @@index([assignedStaffId])
}

model ChitGroupStaff {
  id         String   @id @default(uuid())
  groupId    String
  staffId    String
  assignedAt DateTime @default(now())

  group ChitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  staff User      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([groupId, staffId])
  @@index([staffId])
}

model ChitGroupMember {
  id           String    @id @default(uuid())
  groupId      String
  subscriberId String
  ticketNumber Int // Ticket number e.g. 1 to 20
  enrolledAt   DateTime  @default(now())
  // Ticket lifecycle (P0): rows are never deleted on surrender; history is preserved.
  status       String    @default("ACTIVE") // ACTIVE | SURRENDERED | EXITED
  exitedAt     DateTime?
  exitReason   String?
  exitRefundId String? // Refund (surrender) that ended this membership

  group      ChitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  auctionsWon         Auction[]
  dividendAllocations AuctionDividendAllocation[]
  dues                MemberDue[]

  @@unique([groupId, ticketNumber])
  @@unique([groupId, subscriberId])
  @@index([subscriberId])
  @@index([groupId, status])
}

model InstallmentSchedule {
  id              String   @id @default(uuid())
  groupId         String
  installmentNo   Int
  dueDate         String // YYYY-MM-DD
  scheduledAmount Decimal  @db.Decimal(15, 2)
  dividendAmount  Decimal  @default(0.0) @db.Decimal(15, 2)
  netDueAmount    Decimal  @db.Decimal(15, 2) // scheduledAmount - dividendAmount
  createdAt       DateTime @default(now())

  group ChitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, installmentNo])
}

model PaymentTransaction {
  id                 String   @id @default(uuid())
  companyId          String
  subscriberId       String
  groupId            String
  installmentNo      Int
  amount             Decimal  @db.Decimal(15, 2)
  paymentMode        String // CASH, BANK_TRANSFER, UPI
  receiptNo          String
  externalRef        String? // Bank / UPI Txn Reference ID
  receiptPhoto       String? // Photo / image of receipt proof
  installmentType    String?  @default("REGULAR") // REGULAR, ADVANCE, BACKLOG
  rejectionReason    String? // Reason if rejected by manager
  recordedByUserId   String
  verificationStatus String   @default("VERIFIED") // VERIFIED, PENDING_VERIFICATION, REJECTED, REVERSED
  isReversed         Boolean  @default(false)
  reversalReason     String?
  idempotencyKey     String?
  notes              String?
  createdAt          DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id])
  subscriber Subscriber @relation(fields: [subscriberId], references: [id])
  group      ChitGroup  @relation(fields: [groupId], references: [id])
  recordedBy User       @relation("RecordedBy", fields: [recordedByUserId], references: [id])

  receipt     Receipt?
  allocations PaymentAllocation[]

  @@unique([companyId, receiptNo])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([companyId, verificationStatus])
  @@index([subscriberId])
  @@index([groupId, installmentNo])
  @@index([recordedByUserId, createdAt])
}

model Receipt {
  id            String   @id @default(uuid())
  transactionId String   @unique
  receiptNo     String
  printedCount  Int      @default(1)
  pdfPath       String?
  createdAt     DateTime @default(now())

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([receiptNo])
}

model Auction {
  id                 String   @id @default(uuid())
  groupId            String
  installmentNo      Int
  auctionDate        String // YYYY-MM-DD
  winningBidDiscount Decimal  @db.Decimal(15, 2) // Bid discount given up by winner e.g. 50000.00
  foremanCommission  Decimal  @db.Decimal(15, 2) // Commission kept by Foreman e.g. 25000.00 (5% of chit value)
  totalDividend      Decimal  @db.Decimal(15, 2) // Distributable dividend (winningBidDiscount - foremanCommission)
  dividendPerMember  Decimal  @db.Decimal(15, 2) // totalDividend / maxMembers
  winnerSubscriberId String
  winningTicketNo    Int
  winnerMemberId     String? // ChitGroupMember (ticket) that won; null for auctions recorded before P0
  status             String   @default("CONFIRMED") // SCHEDULED, IN_PROGRESS, CONFIRMED, CANCELLED
  notes              String?
  calculation        Json? // Calculation inputs + step-by-step breakdown (P0); null for auctions recorded before P0
  calculationVersion String?
  createdAt          DateTime @default(now())

  group            ChitGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  winnerSubscriber Subscriber       @relation("AuctionWinner", fields: [winnerSubscriberId], references: [id])
  winnerMember     ChitGroupMember? @relation(fields: [winnerMemberId], references: [id], onDelete: Restrict)

  bids                AuctionBid[]
  payout              Payout?
  dividendAllocations AuctionDividendAllocation[]

  @@unique([groupId, installmentNo])
  @@index([winnerSubscriberId])
  @@index([winnerMemberId])
}

// Where every rupee of an auction's dividend pool went (P0).
// The sum of all rows of an auction equals Auction.totalDividend exactly.
// Amounts the existing distribution rule does not reach (unfilled seats, rounding
// remainder, final auction without a next instalment) are kept as PENDING_DECISION
// rows instead of being discarded.
model AuctionDividendAllocation {
  id                  String   @id @default(uuid())
  companyId           String
  auctionId           String
  allocationKey       String // "TICKET:<memberId>" | "VACANT_SEATS" | "ROUNDING_REMAINDER" | "NO_NEXT_INSTALLMENT" (non-null => unique key always enforced)
  kind                String // TICKET_CREDIT | VACANT_SEATS | ROUNDING_REMAINDER | NO_NEXT_INSTALLMENT
  memberId            String?
  subscriberId        String?
  ticketNumber        Int?
  amount              Decimal  @db.Decimal(15, 2)
  targetInstallmentNo Int?
  status              String // CREDITED_TO_INSTALLMENT | PENDING_DECISION
  note                String?
  createdAt           DateTime @default(now())

  auction Auction          @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  member  ChitGroupMember? @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([auctionId, allocationKey])
  @@index([companyId, status])
  @@index([memberId])
}

model AuctionBid {
  id           String   @id @default(uuid())
  /// legacy column (unused before P8); null for engine online bids
  auctionId    String?
  subscriberId String
  bidDiscount  Decimal  @db.Decimal(15, 2)
  bidTime      DateTime @default(now())

  // P8 online bidding (engine sessions)
  sessionId       String?
  companyId       String?
  memberId        String?
  /// per-session order of accepted bids (= session event sequence); null for rejected attempts
  sequenceNo      Int?
  clientRequestId String?
  /// ACCEPTED | REJECTED
  status          String?
  rejectReason    String?
  /// ONLINE (member) | PROXY (manager on behalf, D-16) | FLOOR (manager-entered, hybrid)
  source          String?
  placedByUserId  String?

  auction    Auction?        @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  subscriber Subscriber      @relation(fields: [subscriberId], references: [id])
  session    AuctionSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, sequenceNo])
  @@unique([sessionId, memberId, clientRequestId])
  @@index([auctionId])
  @@index([subscriberId])
  @@index([sessionId, status])
}

model Payout {
  id               String    @id @default(uuid())
  auctionId        String    @unique
  subscriberId     String
  grossBidAmount   Decimal   @db.Decimal(15, 2) // Chit Value - winningBidDiscount
  deductions       Decimal   @default(0.0) @db.Decimal(15, 2) // Any arrears/penalties
  netPayoutAmount  Decimal   @db.Decimal(15, 2) // grossBidAmount - deductions
  paymentMode      String    @default("BANK_TRANSFER") // BANK_TRANSFER, CHEQUE, CASH
  transactionRef   String?
  status           String    @default("PENDING") // PENDING, APPROVED, DISBURSED, REJECTED
  approvedByUserId String?
  approvedAt       DateTime?
  disbursedAt      DateTime?
  createdAt        DateTime  @default(now())

  auction    Auction    @relation(fields: [auctionId], references: [id])
  subscriber Subscriber @relation(fields: [subscriberId], references: [id])
  approvedBy User?      @relation("ApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([subscriberId])
  @@index([status])
  @@index([approvedByUserId])
}

model CashHandover {
  id               String    @id @default(uuid())
  companyId        String
  staffUserId      String
  handoverDate     String // YYYY-MM-DD
  expectedCash     Decimal   @db.Decimal(15, 2)
  actualCash       Decimal   @db.Decimal(15, 2)
  difference       Decimal   @db.Decimal(15, 2) // actualCash - expectedCash
  status           String    @default("SUBMITTED") // SUBMITTED, VERIFIED, DISCREPANCY
  notes            String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id])
  staff      User    @relation("StaffHandover", fields: [staffUserId], references: [id])
  verifiedBy User?   @relation("ManagerVerification", fields: [verifiedByUserId], references: [id])

  @@index([companyId, handoverDate])
  @@index([staffUserId, handoverDate])
  @@index([verifiedByUserId])
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  category    String // RENT, UTILITIES, SALARY, TRAVEL, MISC
  amount      Decimal  @db.Decimal(15, 2)
  expenseDate String // YYYY-MM-DD
  description String
  recordedBy  String
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, expenseDate])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String? // JSON formatted details
  ipAddress String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, action])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String   @id @default(uuid())
  companyId      String
  code           String // e.g. "1001", "1002", "2001", "3001", "4001", "5001"
  name           String // e.g. "Cash on Hand", "Bank Account", "Chit Subscriptions", "Salaries"
  type           String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  openingBalance Decimal  @default(0.0) @db.Decimal(15, 2)
  currentBalance Decimal  @default(0.0) @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines    JournalEntryLine[]
  mappings AccountMapping[]

  @@unique([companyId, code])
}

model JournalEntry {
  id         String   @id @default(uuid())
  companyId  String
  entryNo    String
  date       String // YYYY-MM-DD
  narration  String
  isBalanced Boolean  @default(true)
  status     String   @default("POSTED") // DRAFT, POSTED, REVERSED
  createdAt  DateTime @default(now())

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalEntryLine[]

  // P4: automatic postings link to their source event; reversals link to the entry they reverse
  sourceEventId String?         @unique
  reversalOfId  String?         @unique
  sourceEvent   FinancialEvent? @relation("EventJournal", fields: [sourceEventId], references: [id], onDelete: Restrict)

  @@unique([companyId, entryNo])
  @@index([companyId, date])
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  type           String // DEBIT, CREDIT
  amount         Decimal @db.Decimal(15, 2)
  description    String?
  // P4 dimensions (instead of one account per group / subscriber)
  groupId        String?
  subscriberId   String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([groupId])
  @@index([subscriberId])
}

model Refund {
  id               String    @id @default(uuid())
  companyId        String
  subscriberId     String
  groupId          String
  amount           Decimal   @db.Decimal(15, 2)
  reason           String
  status           String    @default("REQUESTED") // REQUESTED, APPROVED, DISBURSED, REJECTED
  approvedByUserId String?
  approvedAt       DateTime?
  disbursedAt      DateTime?
  createdAt        DateTime  @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id])
  group      ChitGroup  @relation(fields: [groupId], references: [id])

  @@index([companyId, status])
  @@index([subscriberId])
  @@index([groupId])
}

model Notification {
  id             String   @id @default(uuid())
  title          String
  message        String
  type           String   @default("GENERAL_ANNOUNCEMENT")
  priority       String   @default("NORMAL")
  targetType     String // ALL_MANAGERS, SINGLE_MANAGER, ALL_STAFF, SINGLE_STAFF
  targetId       String?
  targetName     String?
  channels       String   @default("IN_APP")
  recipientCount Int      @default(1)
  recipients     String?
  senderId       String?
  senderName     String?
  senderRole     String?
  companyId      String?
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([targetType, targetId])
}

model Business {
  id        String   @id @default(uuid())
  companyId String?
  managerId String
  name      String
  category  String?  @default("GENERAL_STORE")
  phone     String?
  address   String?
  currency  String   @default("INR")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager          User            @relation("ManagerBusinesses", fields: [managerId], references: [id], onDelete: Cascade)
  staffAssignments BusinessStaff[]
  customers        KhataCustomer[]

  @@index([companyId])
  @@index([managerId])
}

model BusinessStaff {
  id         String   @id @default(uuid())
  businessId String
  staffId    String
  assignedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    User     @relation("StaffAssignedBusinesses", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([businessId, staffId])
  @@index([staffId])
}

model KhataCustomer {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  phone          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  status         String   @default("ACTIVE")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactions KhataTransaction[]

  @@index([businessId])
  @@index([createdById])
}

model KhataTransaction {
  id               String   @id @default(uuid())
  customerId       String
  type             String // GAVE (You Gave / Maine Diye), GOT (You Got / Mujhe Mile)
  amount           Decimal  @db.Decimal(15, 2)
  description      String?
  billPhoto        String?
  paymentMode      String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  recordedByUserId String?
  transactionDate  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer   KhataCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedBy User?         @relation("KhataTxRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, transactionDate])
  @@index([recordedByUserId])
}

// Atomic per-company counters used to generate human-readable codes
// (receipt numbers, subscriber codes, group codes, journal entry numbers)
// without count()+1 race conditions.
model CompanySequence {
  companyId String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
}

// ---------------------------------------------------------------------------
// P2 — Configuration system (docs/auction-engine/DATABASE_DESIGN.md §3, migration M1)
// Append-only: versions are never edited after leaving DRAFT; activation moves the
// PolicyPointer. Snapshots are frozen copies of the resolved configuration.
// ---------------------------------------------------------------------------

enum PolicyScope {
  COMPANY
  GROUP
  AUCTION
}

enum PolicyKind {
  CHIT_ECONOMICS
  AUCTION_RULES
  BIDDING
  DIVIDEND
  CONTRIBUTION
  PENALTY
  DEFAULT_HANDLING
  ELIGIBILITY
  SETTLEMENT
  SCHEDULING
  ROUNDING
  INTEREST_PRODUCT
  LEGAL_LIMITS
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REJECTED
}

model FinancialPolicyVersion {
  id            String       @id @default(uuid())
  companyId     String
  scope         PolicyScope
  /// "COMPANY" | "GROUP:<groupId>" (AUCTION scope arrives with auction sessions, P5). Never NULL.
  scopeKey      String
  groupId       String?
  kind          PolicyKind
  version       Int
  schemaVersion Int
  values        Json
  status        PolicyStatus @default(DRAFT)
  reason        String?
  decisionNote  String?
  createdById   String
  /// user who activated or rejected the version
  decidedById   String?
  createdAt     DateTime     @default(now())
  activatedAt   DateTime?
  supersededAt  DateTime?
  rejectedAt    DateTime?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  group     ChitGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy User           @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy User?          @relation("PolicyDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  pointer   PolicyPointer?

  @@unique([companyId, scopeKey, kind, version])
  @@index([companyId, kind, status])
  @@index([groupId])
  @@index([createdById])
  @@index([decidedById])
}

model PolicyPointer {
  companyId String
  scopeKey  String
  kind      PolicyKind
  versionId String     @unique
  updatedAt DateTime   @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  version FinancialPolicyVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@id([companyId, scopeKey, kind])
}

model ConfigSnapshot {
  id            String   @id @default(uuid())
  companyId     String
  /// "AUCTION_SESSION" | "INTEREST_ACCOUNT" | "GROUP_ACTIVATION"
  subjectType   String
  subjectId     String
  resolved      Json
  sources       Json
  engineVersion String
  /// sha256 of the canonical JSON of `resolved`
  hash          String
  lockedAt      DateTime @default(now())
  lockedById    String?

  company  Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lockedBy User?   @relation("SnapshotLockedBy", fields: [lockedById], references: [id], onDelete: Restrict)

  @@unique([subjectType, subjectId])
  @@index([companyId, lockedAt])
  @@index([lockedById])
}

// ---------------------------------------------------------------------------
// P3 — Per-ticket dues, payment allocation, penalties, adjustments (migration M2)
// Only groups converted to the engine (ChitGroup.engineVersion = "ENGINE_V1") have rows here.
// Money stays exact (Prisma.Decimal, see ENGINE_DECIMAL_MODELS). Business dates: YYYY-MM-DD.
// ---------------------------------------------------------------------------

model ContributionPeriod {
  id         String   @id @default(uuid())
  companyId  String
  groupId    String
  periodNo   Int
  dueDate    String
  baseAmount Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())

  group ChitGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  dues  MemberDue[]

  @@unique([groupId, periodNo])
  @@index([companyId, dueDate])
}

/// One obligation per ticket per contribution period. Status is derived on read (as-of date).
model MemberDue {
  id                 String   @id @default(uuid())
  companyId          String
  groupId            String
  periodId           String
  periodNo           Int
  memberId           String
  subscriberId       String
  dueDate            String
  grossAmount        Decimal  @db.Decimal(15, 2)
  dividendCredit     Decimal  @default(0) @db.Decimal(15, 2)
  penaltyAmount      Decimal  @default(0) @db.Decimal(15, 2)
  penaltyWaived      Decimal  @default(0) @db.Decimal(15, 2)
  contributionWaived Decimal  @default(0) @db.Decimal(15, 2)
  paidAmount         Decimal  @default(0) @db.Decimal(15, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  group       ChitGroup             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  period      ContributionPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  member      ChitGroupMember       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  penalties   PenaltyCharge[]
  adjustments FinancialAdjustment[]

  @@unique([memberId, periodNo])
  @@index([companyId, groupId, dueDate])
  @@index([subscriberId])
  @@index([periodId])
}

/// How each verified payment of an engine group was applied. Reversal marks rows, never deletes.
model PaymentAllocation {
  id         String    @id @default(uuid())
  companyId  String
  paymentId  String
  dueId      String?
  /// DUE | ADVANCE | LEGACY_EXITED_TICKET
  bucket     String
  amount     Decimal   @db.Decimal(15, 2)
  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  due     MemberDue?         @relation(fields: [dueId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([dueId])
  @@index([companyId, bucket])
}

/// A penalty charged on one due. chargeKey makes penalty runs idempotent (one charge per missed period).
model PenaltyCharge {
  id        String   @id @default(uuid())
  companyId String
  dueId     String
  chargeKey String   @unique
  amount    Decimal  @db.Decimal(15, 2)
  asOf      String
  rule      Json
  createdAt DateTime @default(now())

  due MemberDue @relation(fields: [dueId], references: [id], onDelete: Restrict)

  @@index([dueId])
  @@index([companyId, createdAt])
}

/// Waivers, with optional maker–checker (SETTLEMENT.adjustmentApproval).
model FinancialAdjustment {
  id            String    @id @default(uuid())
  companyId     String
  groupId       String
  /// PENALTY_WAIVER | DUE_WAIVER
  type          String
  dueId         String
  amount        Decimal   @db.Decimal(15, 2)
  reason        String
  /// REQUESTED | APPLIED | REJECTED
  status        String
  requestedById String
  decidedById   String?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  due         MemberDue @relation(fields: [dueId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?     @relation("AdjustmentDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([dueId])
  @@index([requestedById])
  @@index([decidedById])
}

/// Result of converting a legacy group to the engine (reconciliation report kept permanently).
model EngineConversion {
  id            String   @id @default(uuid())
  companyId     String
  groupId       String   @unique
  snapshotId    String
  report        Json
  convertedById String
  convertedAt   DateTime @default(now())

  group       ChitGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  convertedBy User      @relation(fields: [convertedById], references: [id], onDelete: Restrict)

  @@index([convertedById])
}

// ---------------------------------------------------------------------------
// P4 — Accounting integration (migration M3). Domain changes record a FinancialEvent in the same
// transaction; the posting engine turns it into one balanced JournalEntry when the company has a
// ledger cut-over date, a complete account mapping and the period is open. Otherwise the event is
// kept NOT_POSTED with the reason (never silently dropped).
// ---------------------------------------------------------------------------

model AccountMapping {
  companyId   String
  /// CASH, BANK, SUBSCRIBER_RECEIVABLE, SUBSCRIBER_ADVANCE, CHIT_POOL_PAYABLE, PRIZE_PAYABLE, ...
  role        String
  accountId   String
  updatedById String
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([companyId, role])
  @@index([accountId])
}

model FinancialEvent {
  id                String    @id @default(uuid())
  companyId         String
  type              String
  sourceType        String
  sourceId          String
  idempotencyKey    String
  /// business date YYYY-MM-DD
  occurredOn        String
  amount            Decimal   @db.Decimal(15, 2)
  payload           Json
  groupId           String?
  subscriberId      String?
  /// POSTED | NOT_POSTED
  postingStatus     String    @default("NOT_POSTED")
  notPostedReason   String?
  rulesVersion      String
  reversalOfEventId String?   @unique
  createdAt         DateTime  @default(now())
  postedAt          DateTime?

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?   @relation("EventJournal")
  reversalOf   FinancialEvent? @relation("EventReversal", fields: [reversalOfEventId], references: [id], onDelete: Restrict)
  reversedBy   FinancialEvent? @relation("EventReversal")

  @@unique([companyId, idempotencyKey])
  @@index([companyId, type, occurredOn])
  @@index([companyId, postingStatus])
  @@index([sourceType, sourceId])
}

/// Accounting periods with a posting lock (replaces the audit-log-only "close" — D-20).
model FinancialPeriod {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  startDate  String
  endDate    String
  /// OPEN | CLOSED
  status     String    @default("OPEN")
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, startDate])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// P5 — Auction schedules, sessions and settlements (migration M4). Engine groups only.
// Times: opensAt/closesAt are instants (UTC); scheduledDate/occurrenceKey are IST business dates.
// The legacy Auction/Payout rows created at settlement are projections of AuctionSettlement.
// ---------------------------------------------------------------------------

model AuctionSchedule {
  id               String    @id @default(uuid())
  companyId        String
  groupId          String
  /// DAILY | WEEKLY | MONTHLY_BY_DAY | MONTHLY_BY_WEEKDAY | EXPLICIT_DATES
  frequency        String
  interval         Int       @default(1)
  byWeekdays       Int[]
  byMonthDays      Int[]
  byWeekdayOrdinal Int?
  explicitDates    String[]
  startDate        String
  endDate          String?
  maxOccurrences   Int?
  opensAtLocal     String
  closesAtLocal    String
  /// SKIP | NEXT_BUSINESS_DAY | PREVIOUS_BUSINESS_DAY | IGNORE
  holidayPolicy    String
  weeklyOffDays    Int[]
  /// ACTIVE | ENDED
  status           String    @default("ACTIVE")
  generatedUntil   String?
  createdById      String
  createdAt        DateTime  @default(now())
  endedAt          DateTime?

  group     ChitGroup        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy User             @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sessions  AuctionSession[]

  @@index([companyId, status])
  @@index([groupId])
  @@index([createdById])
}

model Holiday {
  id        String   @id @default(uuid())
  companyId String
  date      String
  name      String
  createdAt DateTime @default(now())

  @@unique([companyId, date])
}

model AuctionSession {
  id               String    @id @default(uuid())
  companyId        String
  groupId          String
  scheduleId       String?
  /// original planned date (stable identity of a scheduled occurrence; postponement keeps it)
  occurrenceKey    String?
  sequenceNo       Int
  scheduledDate    String
  opensAt          DateTime
  closesAt         DateTime
  extendedUntil    DateTime?
  extensions       Int       @default(0)
  /// OFFLINE | ONLINE | HYBRID
  mode             String
  /// SCHEDULED | OPEN | CLOSED | PENDING_APPROVAL | SETTLED | CANCELLED | NO_BID
  status           String    @default("SCHEDULED")
  configSnapshotId String?   @unique
  resultAuctionId  String?   @unique
  statusReason     String?
  lastEventSeq     Int       @default(0)
  bestBidId        String?
  rowVersion       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group       ChitGroup             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  schedule    AuctionSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  settlements AuctionSettlement[]
  bids        AuctionBid[]
  events      AuctionSessionEvent[]

  @@unique([scheduleId, occurrenceKey])
  @@unique([groupId, sequenceNo])
  @@index([companyId, status, opensAt])
  @@index([groupId, scheduledDate])
}

/// Reproducibility record of an engine calculation (inputs, policy, outputs and their hashes).
model CalculationRun {
  id               String   @id @default(uuid())
  companyId        String
  engine           String
  kind             String
  engineVersion    String
  configSnapshotId String?
  inputs           Json
  policy           Json
  outputs          Json
  inputHash        String
  policyHash       String
  outputHash       String
  createdById      String?
  createdAt        DateTime @default(now())

  settlement AuctionSettlement?

  @@index([companyId, kind, createdAt])
}

model AuctionSettlement {
  id                  String    @id @default(uuid())
  companyId           String
  groupId             String
  sessionId           String
  revision            Int
  calculationRunId    String    @unique
  winnerMemberId      String
  winnerSubscriberId  String
  winningDiscount     Decimal   @db.Decimal(15, 2)
  commission          Decimal   @db.Decimal(15, 2)
  commissionShortfall Decimal   @db.Decimal(15, 2)
  dividendPool        Decimal   @db.Decimal(15, 2)
  dividendPerShare    Decimal   @db.Decimal(15, 2)
  roundingRemainder   Decimal   @db.Decimal(15, 2)
  dividendCredited    Decimal   @db.Decimal(15, 2)
  dividendUnallocated Decimal   @db.Decimal(15, 2)
  grossPrize          Decimal   @db.Decimal(15, 2)
  deductions          Decimal   @db.Decimal(15, 2)
  netPrize            Decimal   @db.Decimal(15, 2)
  targetPeriodNo      Int?
  /// PENDING_APPROVAL | SETTLED | REJECTED | REVERSED
  status              String
  submittedById       String
  approvedById        String?
  decisionNote        String?
  settledAt           DateTime?
  auctionId           String?   @unique
  reversedAt          DateTime?
  reversedById        String?
  reversalReason      String?
  createdAt           DateTime  @default(now())

  session        AuctionSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  calculationRun CalculationRun   @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)
  submittedBy    User             @relation("SettlementSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy     User?            @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  dividends      DividendRecord[]

  @@unique([sessionId, revision])
  @@index([companyId, status, settledAt])
  @@index([groupId, status])
  @@index([submittedById])
  @@index([approvedById])
}

/// Every paisa of a settlement's dividend pool (ticket shares, vacant seats, remainder, ...).
model DividendRecord {
  id             String    @id @default(uuid())
  companyId      String
  settlementId   String
  key            String
  kind           String
  /// CREDIT_TO_PERIOD | PAYABLE_IN_CASH | PENDING_DECISION | ROUNDING_RESERVE
  status         String
  amount         Decimal   @db.Decimal(15, 2)
  memberId       String?
  subscriberId   String?
  targetPeriodNo Int?
  appliedDueId   String?
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())

  settlement AuctionSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([settlementId, key])
  @@index([companyId, status])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// P6 — Eligibility decisions (migration M4b). Evaluations at session open and on demand;
// overrides (overridable rules only, with a reason) are separate rows, never edits.
// ---------------------------------------------------------------------------

model EligibilityDecision {
  id              String   @id @default(uuid())
  companyId       String
  sessionId       String
  memberId        String
  eligible        Boolean
  results         Json
  configHash      String
  overriddenById  String?
  overriddenRules String[]
  overrideReason  String?
  evaluatedAt     DateTime @default(now())

  @@index([sessionId, memberId])
  @@index([companyId, evaluatedAt])
}

// ---------------------------------------------------------------------------
// P8 — Online bidding (migration M6). Every accepted bid and lifecycle change of an online
// session is an event with a per-session sequence number (realtime resync cursor).
// ---------------------------------------------------------------------------

model AuctionSessionEvent {
  id        String   @id @default(uuid())
  sessionId String
  seq       Int
  /// OPENED | BID | EXTENDED | CLOSED | SETTLED | CANCELLED
  type      String
  payload   Json
  createdAt DateTime @default(now())

  session AuctionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, seq])
}
