# =====================================================================
# ChitKart backend environment — copy to backend/.env and fill in.
# backend/.env is git-ignored. NEVER commit real values.
# All variables here are SERVER-SIDE SECRETS/CONFIG: never put them in the
# mobile/web app (only EXPO_PUBLIC_* variables in mobile/.env reach the client).
# =====================================================================

# --- Runtime ---------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the API (Vercel / Render = 1, local = 0).
TRUST_PROXY=0

# --- Database (Supabase PostgreSQL) — REQUIRED ------------------------
# Supabase dashboard -> project -> Connect.
# DATABASE_URL: Transaction pooler (port 6543) + pgbouncer=true  (used by the app at runtime)
# DIRECT_URL:   Session pooler or direct connection (port 5432)  (used by `prisma migrate`)
# Project for development: chit-fund-dev (ref vulzvenuhsbdffhdvewd, region ap-south-1).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
# Local PostgreSQL alternative (docker compose up db):
# DATABASE_URL="postgresql://chitkart:chitkart@localhost:5432/chitkart_dev"
# DIRECT_URL="postgresql://chitkart:chitkart@localhost:5432/chitkart_dev"

# --- Authentication — REQUIRED ----------------------------------------
# Two DIFFERENT random secrets, at least 32 characters each:  openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# --- CORS --------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
# Development default (when unset): http://localhost:8081,http://localhost:19006,http://localhost:5000
# Production: list your exact web app origin(s); "*" is rejected in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Public URL of the web app, used in emails ("log in at ...").
PORTAL_URL=http://localhost:8081

# --- Email (optional) ------------------------------------------------
# Used for password-reset OTPs and new-account credential emails.
# Leave SMTP_USER/SMTP_PASS empty to disable email (password reset by email then cannot complete).
# Gmail: use an App Password, SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="ChitKart Platform <no-reply@example.com>"
# Shown to super admins as the platform support contact (optional).
SUPPORT_EMAIL=

# --- Uploads / limits -------------------------------------------------
# Max size in bytes of an uploaded receipt/bill photo (base64 data URL). Default 5 MB.
MAX_UPLOAD_BYTES=5242880
# Set to false only for automated tests.
RATE_LIMIT_ENABLED=true

# --- Seeding the first super admin (npm run prisma:seed) ---------------
# Only needed when running the seed script. Password must meet the password policy.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_FULLNAME=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_EMAIL=

# Auction engine scheduler (P5). Optional: an external cron (Vercel Cron, Render cron, pg_cron, …)
# calls POST /api/v1/engine/scheduler/run with header "X-Cron-Secret: <value>" to materialise
# scheduled auctions, open/close online auctions and post accounting. At least 32 characters.
# Leave empty to run the scheduler only from the manager app.
CRON_SECRET=
