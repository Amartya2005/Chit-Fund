# =====================================================================
# ChitKart mobile / web app — copy to mobile/.env (git-ignored).
# EXPO_PUBLIC_* values are compiled INTO the app bundle and are visible to
# anyone who has the app. Only put PUBLIC values here — never database URLs,
# JWT secrets, SMTP passwords or Supabase service keys.
# =====================================================================

# Base URL of the ChitKart API, including /api/v1.
# Leave empty for web builds served from the same origin as the API (Vercel),
# or for local web development (defaults to http://localhost:5000/api/v1).
# Native builds: set this to your deployed API, e.g. https://api.example.com/api/v1
# (Android emulator + local backend: http://10.0.2.2:5000/api/v1)
EXPO_PUBLIC_API_URL=
